# Keep the standalone source snapshot reviewable and reject a partial checkout.
file(READ "${_rebuild}/SNAPSHOT.json" _snapshot)
string(JSON _count LENGTH "${_snapshot}" files)
math(EXPR _last "${_count}-1")
foreach(_index RANGE 0 ${_last})
  string(JSON _path GET "${_snapshot}" files ${_index} path)
  string(JSON _expected GET "${_snapshot}" files ${_index} sha256)
  if(NOT EXISTS "${_rebuild}/${_path}")
    message(FATAL_ERROR "Missing standalone source snapshot file: ${_path}")
  endif()
  file(SHA256 "${_rebuild}/${_path}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Standalone source snapshot changed without updating SNAPSHOT.json: ${_path}")
  endif()
endforeach()
