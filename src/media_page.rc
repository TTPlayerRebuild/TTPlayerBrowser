#include <windows.h>
#include <commctrl.h>
301 RCDATA "media_page.html"
302 HTML "media_page_ie.html"
#pragma code_page(65001)
303 DIALOGEX 0, 0, 300, 215
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑媒体来源"
FONT 9, "宋体"
BEGIN
    LTEXT "名称", -1, 8, 10, 62, 12
    EDITTEXT 5311, 74, 8, 218, 14, ES_AUTOHSCROLL
    LTEXT "类型", -1, 8, 29, 62, 12
    COMBOBOX 5312, 74, 26, 218, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "服务器地址", -1, 8, 47, 62, 12
    EDITTEXT 5301, 74, 44, 218, 14, ES_AUTOHSCROLL
    LTEXT "认证方式", -1, 8, 65, 62, 12
    COMBOBOX 5302, 74, 62, 218, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "用户名", -1, 8, 83, 62, 12
    EDITTEXT 5303, 74, 80, 218, 14, ES_AUTOHSCROLL
    LTEXT "密码 / 密钥", -1, 8, 101, 62, 12
    EDITTEXT 5304, 74, 98, 218, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "起始目录", -1, 8, 119, 62, 12
    EDITTEXT 5305, 74, 116, 218, 14, ES_AUTOHSCROLL
    LTEXT "目录密码", -1, 8, 137, 62, 12
    EDITTEXT 5306, 74, 134, 218, 14, ES_AUTOHSCROLL | ES_PASSWORD
    CONTROL "通过 OpenList 服务器代理音频", 5307, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 74, 153, 218, 13
    LTEXT "", 5310, 8, 173, 284, 18, SS_NOPREFIX
    PUSHBUTTON "测试连接", 5309, 8, 194, 62, 15
    DEFPUSHBUTTON "确定", IDOK, 184, 194, 50, 15
    PUSHBUTTON "取消", IDCANCEL, 242, 194, 50, 15
END
// Use the same dialog units, native report list and icon toolbar arrangement
// as IDD_LYRIC_SERVICES. Owner draw also covers synchronous BUTTON state paints.
304 DIALOGEX 0, 0, 280, 180
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "宋体"
BEGIN
    CONTROL "", 5300, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 8, 245, 148
    CONTROL "添加", 5320, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 257, 8, 15, 14
    CONTROL "删除", 5321, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 257, 22, 15, 14
    CONTROL "上移", 5322, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 257, 36, 15, 14
    CONTROL "下移", 5323, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 257, 50, 15, 14
    CONTROL "编辑", 5324, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 257, 142, 15, 14
    LTEXT "双击来源或点击编辑图标进行编辑。", 5310, 8, 161, 264, 13, SS_NOPREFIX
END
